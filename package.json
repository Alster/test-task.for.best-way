{
    "name": "test-task.for.best-way",
    "version": "0.0.1",
    "description": "Completed test task for Best Way company",
    "author": "anik123wb@gmail.com",
    "private": false,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "format": "biome check ./src ./package.json --write",
        "postinstall": "prisma generate",
        "prepare": "effect-language-service patch",
        "start": "nest start",
        "start:debug": "nest start --debug --watch",
        "start:dev": "nest start --watch",
        "start:prod": "node src/main"
    },
    "packageManager": "pnpm@9.4.0",
    "dependencies": {
        "@fastify/cookie": "9.3.1",
        "@fastify/static": "7.0.4",
        "@nestjs/common": "10.3.9",
        "@nestjs/core": "10.3.9",
        "@nestjs/platform-fastify": "10.3.9",
        "@prisma/client": "5.15.1",
        "@redis/client": "1.5.16",
        "cookie-parser": "1.4.6",
        "effect": "^3.19.15",
        "fastify": "4.28.0",
        "handlebars": "4.7.8",
        "nestjs-cls": "4.3.0",
        "prisma": "5.15.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.1",
        "ts-pattern": "5.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.0.6",
        "@effect/language-service": "^0.72.0",
        "@nestjs/cli": "10.3.2",
        "@nestjs/schematics": "10.1.1",
        "@nestjs/testing": "10.3.9",
        "@types/jest": "29.5.12",
        "@types/node": "20.14.5",
        "dotenv": "16.4.5",
        "dotenv-cli": "7.4.2",
        "jest": "29.7.0",
        "jest-mock-extended": "3.0.7",
        "nodemon": "3.1.4",
        "ts-jest": "29.1.5",
        "tsx": "4.21.0",
        "typescript": "5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "roots": [
            "src"
        ],
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "testTimeout": 30000,
        "clearMocks": true,
        "preset": "ts-jest"
    }
}
