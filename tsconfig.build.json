{
    "extends": "./tsconfig.json",
    "exclude": ["node_modules", "test", "dist", "**/*spec.ts"],
    "compilerOptions": {
        "declaration": true,
        "incremental": true,
        "noEmit": false,
        "outDir": "dist",
        "removeComments": false,
        "rootDir": "./",
        "sourceMap": true,
        "tsBuildInfoFile": "./dist/tsbuildinfo.json"
    }
}
